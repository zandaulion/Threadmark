FROM docker.io/library/node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1
ENV NODE_ENV=production
WORKDIR /srv/gmail
COPY gmail/package.json gmail/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts
COPY gmail/*.mjs ./
VOLUME ["/data"]
ENV DATA_DIR=/data HOST=0.0.0.0 PORT=4393 APP_INTERNAL_URL=http://threadmark-app:4390
EXPOSE 4393
CMD ["node", "index.mjs"]
