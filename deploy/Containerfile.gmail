FROM docker.io/library/node:24-alpine
ENV NODE_ENV=production
WORKDIR /srv/gmail
COPY gmail/package.json gmail/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts
COPY gmail/*.mjs ./
VOLUME ["/data"]
ENV DATA_DIR=/data HOST=0.0.0.0 PORT=4393 APP_INTERNAL_URL=http://threadmark-app:4391
EXPOSE 4393
CMD ["node", "index.mjs"]
