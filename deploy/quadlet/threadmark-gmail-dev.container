[Unit]
Description=Threadmark Dev Gmail read-only connector
After=network-online.target threadmark-app.service
Wants=network-online.target threadmark-app.service

[Container]
Image=localhost/threadmark-gmail:latest
ContainerName=threadmark-gmail-dev
Network=threadmark.network
Volume=%h/.local/share/threadmark/gmail-dev:/data:Z
EnvironmentFile=%h/.config/threadmark/gmail.env
Environment=HOST=0.0.0.0
Environment=PORT=4393
Environment=DATA_DIR=/data
Environment=APP_INTERNAL_URL=http://threadmark-app:4390
Environment=GMAIL_PROFILE_ID=dev
NoNewPrivileges=true
DropCapability=all

[Service]
ExecStartPre=/usr/bin/mkdir -p %h/.local/share/threadmark/gmail-dev
Restart=always
RestartSec=8

[Install]
WantedBy=default.target
